# ==========================================================================
# Agents service (agents/)
# Local: copy to .env. Railway: set as variables on the agents service.
# ==========================================================================

# OpenRouter API key (required)
OPENROUTER_API_KEY=

# Model id on OpenRouter
LLM_MODEL=google/gemini-3.8-flash

# OpenAI-compatible base URL
LLM_BASE_URL=https://openrouter.ai/api/v1

# Game server host/port.
# Local default: 127.0.0.1. On Railway: the server service's private
# domain, e.g. OHOL_HOST=ohol-server.railway.internal
OHOL_HOST=127.0.0.1
OHOL_PORT=8005

# Number of agents to run. 4 is for cheap testing; use 8-12 for a viable
# family (2-3 fertile women, 3-5 children, 2-3 adults). Below ~6 one
# starvation breaks the line.
AGENT_COUNT=4

# Fixed decision cadence: a decision starts at least this many ms after the
# previous one started, whatever the provider latency, so every model acts at
# the same pace (comparability). If a turn takes longer, the next one starts
# right after it (no overlap, no backlog). Calibration will set the final
# value (likely 3000-4000 with fast inference). Babies keep their own interval.
DECISION_CYCLE_MS=8000
# BABY_DECISION_INTERVAL_MS=15000

# Starting setup: logins go one at a time until INITIAL_EVES Eves have
# appeared (the stock server alternates Eve, baby, Eve, ...); the other slots
# join every JOIN_STAGGER_S +- JOIN_JITTER (fraction) as babies, each waiting
# until the family has room. A slot whose character died logs in again after
# a random 30-90 s. See README "Run setup".
INITIAL_EVES=2
JOIN_STAGGER_S=90
JOIN_JITTER=0.3
RESPAWN_DELAY_MIN_S=30
RESPAWN_DELAY_MAX_S=90

# Provider outage: failing (401/402/403, 5xx, timeouts) for longer than this
# pauses the run (agents disconnect, logins held, affected lives flagged
# validForStudy=false) until a probe call succeeds. 0 = never pause.
LLM_OUTAGE_PAUSE_S=60

# Prompt caching: mark the static system prompt cacheable (cache_control) for
# Gemini/Claude via OpenRouter; other models cache implicitly. 0 = off.
LLM_PROMPT_CACHE=1
# Record the model's reasoning text in llm.jsonl when returned (never changes
# the request). 0 = off.
LLM_CAPTURE_REASONING=1
# max_tokens per agent call (reasoning tokens count against it)
# LLM_MAX_TOKENS=2000

# OpenRouter routing and reasoning for the agents' model (sent only when set;
# the narrator/director/story keep defaults):
# LLM_PROVIDER_SORT=throughput        # throughput | latency | price
# LLM_PROVIDER_ORDER=groq,cerebras    # provider slugs to try first
# LLM_PROVIDER_ALLOW_FALLBACKS=1      # 0 = only the listed providers
# LLM_REASONING_EFFORT=low            # off | minimal | low | medium | high (empty = model default)
# Stream replies to measure time-to-first-token (same parsed result)
# LLM_STREAM=0

# Agent memory across lives: per-life | persistent
MEMORY_MODE=per-life
# Yearly memory summary of this life (WHAT YOU REMEMBER), rewritten in the background every N turns
# MEMORY_SUMMARY=1
# MEMORY_SUMMARY_TURNS=25

# Recipe hints: 0 | 1
RECIPE_HINTS=1

# craft <item> macro (TEMPORARY intervention, see README "Interventions"): 0 | 1
CRAFT_MACRO=1
# Mild reasoning cap on agent decisions (keeps some reasoning): 0 | 1.
# Reasoning budget in tokens (0 = reasoning effort "low" instead), and the
# total reply budget (reasoning + visible JSON).
LLM_REASONING_CAP=1
LLM_REASONING_MAX_TOKENS=300
LLM_DECISION_MAX_TOKENS=800
# A baby with nothing happening is asked at most this often (ms)
BABY_IDLE_MAX_MS=60000
# Max steps in one reply's "actions" list, run back to back (1 = one action per turn)
ACTION_LIST_MAX=4

# Narrator (every N ms, 0 = off) and its model (default LLM_MODEL)
# Default model for the narrator, director and story (overhead, not agents).
# Recommended cheap + fast: google/gemini-3.1-flash-lite ($0.25/$1.50 per
# Mtok, in OpenRouter's model list as of 2026-11-16). That is the default
# when LLM_BASE_URL is OpenRouter; on other endpoints the default is LLM_MODEL.
OVERHEAD_MODEL=google/gemini-3.1-flash-lite
# Narrator (every N ms, 0 = off) and its model (default OVERHEAD_MODEL)
NARRATOR_INTERVAL_MS=90000
# NARRATOR_MODEL=

# Stream director: picks the one character the stream camera follows.
# Decision interval (0 = off), model (default OVERHEAD_MODEL), minimum time on one
# character before switching, and how long to stay on a character who died.
DIRECTOR_INTERVAL_MS=10000
DIRECTOR_MIN_DWELL_MS=45000
DIRECTOR_DEATH_HOLD_MS=8000
# How it decides: jev (TypeSafe's Jev decision model on OpenRouter's Decisions
# API, ~$0.04/Mtok input, output free), llm (DIRECTOR_MODEL chat model) or
# heuristic (no calls). Default jev when LLM_BASE_URL is OpenRouter, else llm.
# DIRECTOR_ENGINE=jev
# DIRECTOR_JEV_MODEL=typesafe/jev-1.13
# DIRECTOR_MODEL=
# Jev: each character's score is combined = W * P_jev + (1 - W) * normalised
# heuristic salience (W = DIRECTOR_JEV_WEIGHT). Leave the current focus only if
# P(something clearly more interesting elsewhere) >= DIRECTOR_SWITCH_P and
# combined(new pick) - combined(current) >= DIRECTOR_SWITCH_MARGIN. A major
# development elsewhere (an elder near death or in danger, a first-ever item
# about to be or just crafted) skips the margin unless the focus has one too.
DIRECTOR_SWITCH_P=0.7
DIRECTOR_SWITCH_MARGIN=0.15
DIRECTOR_JEV_WEIGHT=0.5

# "Story so far" refresh interval (0 = off) and model (default NARRATOR_MODEL,
# then OVERHEAD_MODEL). Persisted in LOG_DIR/story.jsonl across runs and restarts.
STORY_INTERVAL_MS=900000
# STORY_MODEL=

# HTTP port for the agents API (Railway may inject its own PORT)
PORT=8787

# Log directory (default ./logs relative to the agents dir).
# Research data (lives, lineages, spend) persists under LOG_DIR/research.
LOG_DIR=./logs
# Raw per-run logs (llm.jsonl ~150 MB/day always-on, events.jsonl, ...) rotate
# to <file>.1 past this many MB. 0 = never.
# LOG_MAX_FILE_MB=32
# Max concurrent SSE clients on /api/stream (more get 503).
# SSE_MAX_CLIENTS=200

# Per-run spend cap in USD; the run halts past it. 0 = no cap.
# Default 10, or 0 when CONTINUOUS=1.
# MAX_COST_USD=10

# Always-on mode: 1 = ignore MAX_GENERATION / MAX_LIVES / MAX_RUNTIME_MIN
# and keep the population going indefinitely.
CONTINUOUS=0

# World regeneration (CONTINUOUS only; default 1 there, never otherwise): when
# the run has had characters and none is alive, possibly alive or logging in
# for EXTINCT_GRACE_S, logins are held and the agents ask deploy/start.sh
# (SIGUSR2) to archive and wipe the world and start a fresh one with a new run.
# Needs start.sh (it sets REGEN_REQUEST_FILE); without it, logins resume.
# REGEN_ON_EXTINCTION=1
# EXTINCT_GRACE_S=180
# Logins resume in the old world if the supervisor hasn't acted by then (s).
# REGEN_TIMEOUT_S=600

# Opt-in rolling-24h LLM spend cap (USD) across runs and restarts. 0 = off.
# When reached, LLM calls pause (run status "paused") until the window has room.
DAILY_COST_USD=0

# Trait dimensions (comma-separated). Traits are MOCK for now: assigned and
# inherited, but they don't affect behaviour or prompts.
TRAIT_DIMS=openness,conscientiousness,extraversion,agreeableness,neuroticism
# Per-dimension mutation SD when a child inherits its mother's traits
TRAIT_MUTATION_SD=0.15
# Only "mock" exists until steering is implemented
TRAIT_SOURCE=mock

# ==========================================================================
# Game time dilation (server AND agents: set the same value on both)
# ==========================================================================

# Game clock slowed k x uniformly (aging, hunger, decay, walking...), all
# in-game ratios preserved. 1 = stock. server/run.sh writes it to
# settings/timeScale.ini. See docs/research/time-scale.md for choosing k.
# TIME_SCALE=1

# Turn-based clock (lockstep, docs/turn-clock.md). Set TURN_CLOCK on BOTH the
# server and the agents. The game clock then runs only in act windows the
# agents service opens: everyone decides while the world is frozen, then the
# clock runs TURN_GAME_S game seconds (TURN_GAME_S x TIME_SCALE wall seconds).
# TURN_CLOCK=1
# Agents only: game seconds per turn (60 game s = 1 year, so 2.4 = 25 turns a year)
# TURN_GAME_S=2.4
# Agents only: a reply later than this (s) is dropped; that agent does nothing this turn
# TURN_DECIDE_TIMEOUT_S=20
# Agents only: a baby with nothing salient happening decides at most every N turns
# BABY_IDLE_TURNS=10
# Agents only: the game server's run dir (mtsClockTarget.txt, mtsClockNow.txt).
# Default $WORLD_DIR, else .ohol-run at the repo root (server/run.sh's default).
# deploy/start.sh exports it.
# MTS_CLOCK_DIR=

# ==========================================================================
# Game server (server/run.sh) — set on the Railway server service.
# Every OHOL_SETTING_<name>=<value> writes settings/<name>.ini at startup,
# overriding both stock settings and the copies in server/settings/.
# ==========================================================================

# Declared condition: stock new-player food bonus (+18 s per food pip) for
# every life (server/settings/mtsNewPlayerFoodBonus.ini=1). Turn off with:
# OHOL_SETTING_mtsNewPlayerFoodBonus=0

# Examples:
# OHOL_SETTING_maxPlayers=80
# OHOL_SETTING_apocalypsePossible=0
# PORT_OVERRIDE=8005   # writes settings/port.ini directly (rarely needed)
