# ==========================================================================
# Agents service (agents/)
# Local: copy to .env. Railway: set as variables on the agents service.
# ==========================================================================

# OpenRouter API key (required)
OPENROUTER_API_KEY=

# Model id on OpenRouter
LLM_MODEL=google/gemini-3.8-flash

# OpenAI-compatible base URL
LLM_BASE_URL=https://openrouter.ai/api/v1

# Game server host/port.
# Local default: 127.0.0.1. On Railway: the server service's private
# domain, e.g. OHOL_HOST=ohol-server.railway.internal
OHOL_HOST=127.0.0.1
OHOL_PORT=8005

# Number of agents to run
AGENT_COUNT=4

# Agent memory across lives: per-life | persistent
MEMORY_MODE=per-life

# Recipe hints: 0 | 1
RECIPE_HINTS=1

# HTTP port for the agents API (Railway may inject its own PORT)
PORT=8787

# Log directory (default ./logs relative to the agents dir)
LOG_DIR=./logs

# ==========================================================================
# Game server (server/run.sh) — set on the Railway server service.
# Every OHOL_SETTING_<name>=<value> writes settings/<name>.ini at startup,
# overriding both stock settings and the copies in server/settings/.
# ==========================================================================

# Examples:
# OHOL_SETTING_maxPlayers=80
# OHOL_SETTING_apocalypsePossible=0
# PORT_OVERRIDE=8005   # writes settings/port.ini directly (rarely needed)
