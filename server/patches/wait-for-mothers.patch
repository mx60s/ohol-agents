+// MTS patch (wait-for-mothers.patch): with mtsNoCooldownBypass=1, write
+// mtsBirthReady.txt in the run dir, "<readyCount> <soonestCooldownEnd>":
+// how many fertile women could take a baby right now (off cooldown, below
+// maxLivingChildrenPerMother and the early-birth cap, not cursed, in a
+// place where she may have babies), and the soonest game time (seconds,
+// 0 = none) a cooldown of an otherwise ready woman ends. Checked every
+// 0.5 wall s, written (temp + rename) on change and at least every 3 s.
+static void mtsStepBirthReady() {
+    static double lastCheck = -1;
+    static double lastWrite = -1;
+    static int lastReady = -1;
+    static double lastSoonest = -1;
+
+    if( ! SettingsManager::getIntSetting( "mtsNoCooldownBypass", 0 ) ) {
+        return;
+        }
+    double wall = MTSGameTime::bookkeepingTime();
+    if( lastCheck >= 0 && wall - lastCheck < 0.5 ) {
+        return;
+        }
+    lastCheck = wall;
+
+    int maxLiving =
+        SettingsManager::getIntSetting( "maxLivingChildrenPerMother", 4 );
+    int earlyMax = SettingsManager::getIntSetting( "mtsEarlyMaxBabies", 0 );
+    int earlyGens =
+        SettingsManager::getIntSetting( "mtsEarlyMaxGenerations", 5 );
+    timeSec_t now = Time::timeSec();
+
+    int ready = 0;
+    double soonest = 0;
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( o->error || o->isTutorial || o->vogMode ||
+            o->curseStatus.curseLevel > 0 || ! isFertileAge( o ) ) {
+            continue;
+            }
+        if( earlyMax > 0 && o->parentChainLength <= earlyGens &&
+            o->babyBirthTimes->size() >= earlyMax ) {
+            continue;
+            }
+        if( countLivingChildren( o->id ) >= maxLiving ) {
+            continue;
+            }
+        GridPos pos = getPlayerPos( o );
+        int home = isBirthland( pos.x, pos.y, o->lineageEveID, o->displayID );
+        if( home == -1 || ( home == 0 && o->everHomesick ) ) {
+            continue;
+            }
+        if( now < o->birthCoolDown ) {
+            if( soonest == 0 || o->birthCoolDown < soonest ) {
+                soonest = o->birthCoolDown;
+                }
+            continue;
+            }
+        ready++;
+        }
+
+    if( ready == lastReady && soonest == lastSoonest &&
+        wall - lastWrite < 3 ) {
+        return;
+        }
+    FILE *f = fopen( "mtsBirthReady.txt.tmp", "w" );
+    if( f == NULL ) {
+        return;
+        }
+    fprintf( f, "%d %.0f\n", ready, soonest );
+    fclose( f );
+    rename( "mtsBirthReady.txt.tmp", "mtsBirthReady.txt" );
+    lastReady = ready;
+    lastSoonest = soonest;
+    lastWrite = wall;
+    }
+
+
 int main( int inNumArgs, const char **inArgs ) {
     // use the serverSettings folder if it's available
     setUseServerSettings();
