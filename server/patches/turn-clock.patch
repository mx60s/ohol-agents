+
+        // wall clock that never goes backwards (turn mode only)
+        static double turnReal( State *s, double inReal ) {
+            if( inReal < s->lastReal ) {
+                return s->lastReal;
+                }
+            s->lastReal = inReal;
+            return inReal;
+            }
+
+        static double turnGame( State *s, double inReal ) {
+            if( ! s->running ) {
+                return s->anchorGame;
+                }
+            double g = s->anchorGame +
+                ( inReal - s->anchorReal ) / s->scale;
+            if( g > s->target ) {
+                g = s->target;
+                }
+            if( g < s->anchorGame ) {
+                g = s->anchorGame;
+                }
+            return g;
             }
+
+        // hold at the current game time
+        static void turnHold( State *s, double inReal ) {
+            s->anchorGame = turnGame( s, inReal );
+            s->anchorReal = inReal;
+            s->target = s->anchorGame;
+            s->running = false;
+            }
+
+        // stat the target file; returns true if it is a new file version
+        static char turnTargetChanged( State *s, char *outExists ) {
+            struct stat st;
+            if( stat( "mtsClockTarget.txt", &st ) != 0 ) {
+                *outExists = false;
+                char changed = s->targetExists;
+                s->targetExists = false;
+                return changed;
+                }
+            *outExists = true;
+#ifdef __APPLE__
+            double mtime = st.st_mtimespec.tv_sec +
+                st.st_mtimespec.tv_nsec * 1e-9;
+#else
+            double mtime = st.st_mtim.tv_sec + st.st_mtim.tv_nsec * 1e-9;
+#endif
+            if( s->targetExists &&
+                s->targetIno == (double)st.st_ino &&
+                s->targetSize == (double)st.st_size &&
+                s->targetMtime == mtime ) {
+                return false;
+                }
+            s->targetExists = true;
+            s->targetIno = (double)st.st_ino;
+            s->targetSize = (double)st.st_size;
+            s->targetMtime = mtime;
+            return true;
+            }
+
+        static void turnPollTarget( State *s, double inReal ) {
+            char exists;
+            if( ! turnTargetChanged( s, &exists ) ) {
+                return;
+                }
+            if( ! exists ) {
+                // removed: paused
+                turnHold( s, inReal );
+                return;
+                }
+            FILE *f = fopen( "mtsClockTarget.txt", "r" );
+            if( f == NULL ) {
+                return;
+                }
+            double t;
+            int n = fscanf( f, "%lf", &t );
+            fclose( f );
+            if( n != 1 || ! ( t == t ) ) {
+                printf( "MTS turn clock: unreadable mtsClockTarget.txt, "
+                        "ignored\n" );
+                return;
+                }
+            double g = turnGame( s, inReal );
+            s->anchorGame = g;
+            s->anchorReal = inReal;
+            s->target = ( t > g ) ? t : g;
+            s->running = ( s->target > g );
+            }
+
+        static void turnWriteFile( const char *inName, const char *inText ) {
+            char tmp[ 256 ];
+            snprintf( tmp, sizeof( tmp ), "%s.tmp", inName );
+            FILE *f = fopen( tmp, "w" );
+            if( f == NULL ) {
+                return;
+                }
+            fputs( inText, f );
+            if( fclose( f ) == 0 ) {
+                rename( tmp, inName );
+                }
+            }
+
+        static void turnWrite( double inGame, char inPaused ) {
+            char buf[ 64 ];
+            snprintf( buf, sizeof( buf ), "%.6f\n", inGame );
+            turnWriteFile( "mtsClockGame.txt", buf );
+            snprintf( buf, sizeof( buf ), "%.6f %d\n", inGame,
+                      inPaused ? 1 : 0 );
+            turnWriteFile( "mtsClockNow.txt", buf );
+            }
+
+        static void turnInit( State *s ) {
+            s->turn =
+                ( SettingsManager::getIntSetting( "mtsTurnClock", 0 ) != 0 );
+            if( ! s->turn ) {
+                return;
+                }
+            double real = Time::getCurrentTime();
+            double g = real;
+            if( s->scale != 1.0 ) {
+                g = s->epoch + ( real - s->epoch ) / s->scale;
+                }
+            const char *from = "time-scale clock";
+            FILE *f = fopen( "mtsClockGame.txt", "r" );
+            if( f != NULL ) {
+                double saved;
+                if( fscanf( f, "%lf", &saved ) == 1 && saved > 0 ) {
+                    g = saved;
+                    from = "mtsClockGame.txt";
+                    }
+                fclose( f );
+                }
+            s->lastReal = real;
+            s->anchorGame = g;
+            s->anchorReal = real;
+            s->target = g;
+            s->running = false;
+            s->lastPoll = real;
+            s->lastWrite = real;
+            // a target file from before this boot counts as already seen
+            char exists;
+            turnTargetChanged( s, &exists );
+            turnWrite( g, true );
+            s->reportedPaused = true;
+            printf( "MTS turn clock on: paused at game time %.3f (from %s)"
+                    "%s\n", g, from,
+                    exists ? ", old mtsClockTarget.txt ignored until it "
+                    "changes" : "" );
+            }
     };
 
 
