+// register a restored player's language (stock does this at birth).
+// Restores run before anyone is born, so the only language records are
+// the ones made here.
+static SimpleVector<int> mtsRestoredLanguages;
+
+static void mtsRestoreLanguage( LiveObject *o ) {
+    if( mtsRestoredLanguages.getElementIndex( o->lineageEveID ) != -1 ) {
+        incrementLanguageCount( o->lineageEveID );
+        }
+    else {
+        addEveLanguage( o->lineageEveID );
+        mtsRestoredLanguages.push_back( o->lineageEveID );
+        }
+    }
