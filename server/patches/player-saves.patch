+static void mtsSavePlayers( const char *inWhy ) {
+    if( ! mtsSavesEnabled ) {
+        return;
+        }
+    mtsLastSaveRealTime = mtsRealNow();
+
+    const char *tmpName = MTS_SAVE_FILE ".tmp";
+    FILE *f = fopen( tmpName, "w" );
+    if( f == NULL ) {
+        AppLog::errorF( "MTS player saves: can't open %s for writing",
+                        tmpName );
+        return;
+        }
+
+    int count = 0;
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( ! o->error && ! o->isTutorial && ! o->isGhost ) {
+            count++;
+            }
+        }
+
+    fprintf( f, "MTSPLAYERSAVE %d %.17g %.17g %d %d\n",
+             MTS_SAVE_VERSION,
+             mtsRealNow(), Time::getCurrentTime(), nextID, count );
+
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( ! o->error && ! o->isTutorial && ! o->isGhost ) {
+            mtsWritePlayer( f, o );
+            }
+        }
+    fputs( "END\n", f );
+
+    char ok = ( fflush( f ) == 0 );
+    if( ok ) {
+        fsync( fileno( f ) );
+        }
+    if( fclose( f ) != 0 ) {
+        ok = false;
+        }
+    if( ! ok || rename( tmpName, MTS_SAVE_FILE ) != 0 ) {
+        AppLog::errorF( "MTS player saves: failed to write %s (%s)",
+                        MTS_SAVE_FILE, strerror( errno ) );
+        return;
+        }
+
+    if( strcmp( inWhy, "periodic" ) != 0 ) {
+        AppLog::infoF( "MTS player saves: saved %d living players (%s)",
+                       count, inWhy );
+        }
+    }
