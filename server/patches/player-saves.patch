+
+// at startup, before the main loop
+static void mtsRestorePlayers() {
+    mtsSavesEnabled =
+        SettingsManager::getIntSetting( "mtsPlayerSaves", 0 ) != 0;
+    if( ! mtsSavesEnabled ) {
+        return;
+        }
+    mtsSaveInterval = SettingsManager::getFloatSetting(
+        "mtsPlayerSavesIntervalSeconds", 30 );
+    if( mtsSaveInterval < 1 ) {
+        mtsSaveInterval = 1;
+        }
+    mtsMaxWait = SettingsManager::getFloatSetting(
+        "mtsPlayerSavesMaxWaitSeconds", 900 );
+    double maxDowntime = SettingsManager::getFloatSetting(
+        "mtsPlayerSavesMaxDowntimeSeconds", 1800 );
+    char pause = SettingsManager::getIntSetting(
+        "mtsPlayerSavesPauseDowntime", 1 ) != 0;
+
+    mtsLastSaveRealTime = mtsRealNow();
+    mtsRestoreRealTime = mtsRealNow();
+
+    FILE *f = fopen( MTS_SAVE_FILE, "r" );
+    if( f == NULL ) {
+        AppLog::info( "MTS player saves: no save file, nothing to restore" );
+        return;
+        }
+
+    // read whole file
+    std::string data;
+    char buf[65536];
+    size_t got;
+    while( ( got = fread( buf, 1, sizeof( buf ), f ) ) > 0 ) {
+        data.append( buf, got );
+        if( data.size() > 512 * 1024 * 1024 ) {
+            break;
+            }
+        }
+    fclose( f );
+
+    // split lines
+    std::vector<std::string> lines;
+    size_t start = 0;
+    while( start < data.size() ) {
+        size_t end = data.find( '\n', start );
+        if( end == std::string::npos ) {
+            end = data.size();
+            }
+        lines.push_back( data.substr( start, end - start ) );
+        start = end + 1;
+        }
+
+    int version = 0, savedNextID = 0, count = -1;
+    double saveReal = 0, saveGame = 0;
+    char ok = lines.size() >= 2;
+    if( ok ) {
+        MTSReader R = { lines[0].c_str(), true };
+        int len;
+        const char *tag = R.next( &len );
+        ok = R.ok && len == 13 && strncmp( tag, "MTSPLAYERSAVE", 13 ) == 0;
+        version = R.i();
+        saveReal = R.d();
+        saveGame = R.d();
+        savedNextID = R.i();
+        count = R.n( 100000 );
+        ok = ok && R.ok && version == MTS_SAVE_VERSION;
+        }
+    if( ok ) {
+        ok = ( (int)lines.size() >= count + 2 &&
+               lines[ count + 1 ] == "END" );
+        }
+
+    std::vector<MTSSavedPlayer> saved;
+    for( int k=0; ok && k<count; k++ ) {
+        MTSSavedPlayer r;
+        if( ! mtsReadPlayer( lines[ k + 1 ].c_str(), &r ) ) {
+            AppLog::errorF( "MTS player saves: bad player line %d", k + 2 );
+            ok = false;
+            break;
+            }
+        saved.push_back( r );
+        }
+
+    if( ! ok ) {
+        AppLog::error( "MTS player saves: save file is corrupt, ignoring it "
+                       "(renamed to " MTS_SAVE_FILE ".bad)" );
+        mtsRenameBad( ".bad" );
+        return;
+        }
+
+    double downtime = mtsRealNow() - saveReal;
+    if( downtime > maxDowntime || downtime < -60 ) {
+        AppLog::infoF( "MTS player saves: save is %.0f s old (max %.0f), "
+                       "not restoring %d players (renamed to "
+                       MTS_SAVE_FILE ".stale)",
+                       downtime, maxDowntime, count );
+        mtsRenameBad( ".stale" );
+        return;
+        }
+
+    mtsRestoreShift = pause ? Time::getCurrentTime() - saveGame : 0;
+    if( mtsRestoreShift < 0 ) {
+        mtsRestoreShift = 0;
+        }
+
+    // never hand out a restored id to someone new
+    int maxID = savedNextID - 1;
+    for( unsigned int k=0; k<saved.size(); k++ ) {
+        if( saved[k].id > maxID ) {
+            maxID = saved[k].id;
+            }
+        }
+    if( nextID <= maxID ) {
+        nextID = maxID + 1;
+        }
+
+    int numRestored = 0;
+    for( unsigned int k=0; k<saved.size(); k++ ) {
+        MTSSavedPlayer *r = &( saved[k] );
+
+        ObjectRecord *dispO = mtsValidObject( r->displayID ) ?
+            getObject( r->displayID ) : NULL;
+        if( dispO == NULL || ! dispO->person ) {
+            AppLog::errorF( "MTS player saves: skipping %s, bad display "
+                            "object %d", r->email.c_str(), r->displayID );
+            continue;
+            }
+        char dup = false;
+        for( int i=0; i<players.size(); i++ ) {
+            LiveObject *o = players.getElement( i );
+            if( o->id == r->id || strcmp( o->email, r->email.c_str() ) == 0 ) {
+                dup = true;
+                }
+            }
+        if( dup ) {
+            AppLog::errorF( "MTS player saves: skipping duplicate %s (%d)",
+                            r->email.c_str(), r->id );
+            continue;
+            }
+
+        CurseStatus cs = { r->curseLevel, r->excessPoints };
+        PastLifeStats ls = { r->lifeCount, r->lifeTotalSeconds,
+                             r->accountExistedDays,
+                             (char)r->lifeStatsError };
+        GridPos pos = { r->x, r->y };
+
+        mtsRestoring = r;
+        int id = processLoggedInPlayer( true, NULL, NULL,
+                                        stringDuplicate( r->email.c_str() ),
+                                        (char*)"restored",
+                                        0, cs, ls, (float)r->fitnessScore,
+                                        NULL,
+                                        // forced Eve slot: no mother is
+                                        // picked, no Eve placement
+                                        -2,
+                                        r->displayID,
+                                        &pos,
+                                        // no lifeLog birth
+                                        true );
+        mtsRestoring = NULL;
+
+        if( id > 0 ) {
+            numRestored++;
+            mtsAwaitingReconnect.push_back( id );
+            }
+        }
+
+    // babies in arms: keep only consistent pairs
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( o->heldByOther ) {
+            LiveObject *holder = getLiveObject( o->heldByOtherID );
+            if( holder == NULL || holder->holdingID != - o->id ) {
+                AppLog::infoF( "MTS player saves: %d was held by %d, "
+                               "set down", o->id, o->heldByOtherID );
+                o->heldByOther = false;
+                o->heldByOtherID = -1;
+                }
+            else {
+                o->xs = o->xd = holder->xd;
+                o->ys = o->yd = holder->yd;
+                }
+            }
+        }
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( o->holdingID < 0 ) {
+            LiveObject *baby = getLiveObject( - o->holdingID );
+            if( baby == NULL || ! baby->heldByOther ||
+                baby->heldByOtherID != o->id ) {
+                AppLog::infoF( "MTS player saves: %d was holding baby %d, "
+                               "hands emptied", o->id, - o->holdingID );
+                o->holdingID = 0;
+                }
+            }
+        }
+
+    if( nextID <= maxID ) {
+        nextID = maxID + 1;
+        }
+    SettingsManager::setSetting( "nextPlayerID", (int)nextID );
+
+    AppLog::infoF( "MTS player saves: restored %d of %d players from a "
+                   "save %.0f s old (game time shifted by %.0f s); "
+                   "waiting up to %.0f s for them to reconnect",
+                   numRestored, count, downtime, mtsRestoreShift,
+                   mtsMaxWait );
+    }
+
+
+
+// top of every main-loop step
+static void mtsPlayerSavesStep() {
+    if( ! mtsSavesEnabled ) {
+        return;
+        }
+    double now = mtsRealNow();
+
+    for( int k=0; k<mtsAwaitingReconnect.size(); k++ ) {
+        LiveObject *o =
+            getLiveObject( mtsAwaitingReconnect.getElementDirect( k ) );
+
+        if( o == NULL || o->error || o->connected ) {
+            mtsAwaitingReconnect.deleteElement( k );
+            k--;
+            continue;
+            }
+        if( mtsMaxWait > 0 && now - mtsRestoreRealTime > mtsMaxWait ) {
+            AppLog::infoF( "MTS player saves: restored player %d (%s) never "
+                           "reconnected, dies", o->id, o->email );
+            setDeathReason( o, "disconnected" );
+            o->error = true;
+            o->errorCauseString = "Restored player never reconnected";
+            mtsAwaitingReconnect.deleteElement( k );
+            k--;
+            }
+        }
+
+    if( now - mtsLastSaveRealTime >= mtsSaveInterval ) {
+        mtsSavePlayers( "periodic" );
+        }
+    }
+
+
+#endif
