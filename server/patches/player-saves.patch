+static void mtsRenameBad( const char *inSuffix ) {
+    char *newName = autoSprintf( "%s%s", MTS_SAVE_FILE, inSuffix );
+    rename( MTS_SAVE_FILE, newName );
+    delete [] newName;
+    }
