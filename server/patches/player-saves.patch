+    mtsWStr( f, o->email );
+    mtsWInt( f, o->id );
+    mtsWInt( f, o->displayID );
+    mtsWStr( f, o->name );
+    mtsWStr( f, o->familyName );
+    mtsWInt( f, o->nameHasSuffix );
+    mtsWInt( f, o->isEve );
+    mtsWInt( f, o->isTwin );
+
+    mtsWInt( f, o->parentID );
+    mtsWInt( f, o->parentChainLength );
+    mtsWInt( f, o->lineageEveID );
+    mtsWIntList( f, o->lineage );
+
+    int numAnc = o->ancestorIDs->size();
+    if( o->ancestorEmails->size() < numAnc ) {
+        numAnc = o->ancestorEmails->size();
+        }
+    if( o->ancestorRelNames->size() < numAnc ) {
+        numAnc = o->ancestorRelNames->size();
+        }
+    if( o->ancestorLifeStartTimeSeconds->size() < numAnc ) {
+        numAnc = o->ancestorLifeStartTimeSeconds->size();
+        }
+    mtsWInt( f, numAnc );
+    for( int i=0; i<numAnc; i++ ) {
+        mtsWInt( f, o->ancestorIDs->getElementDirect( i ) );
+        mtsWStr( f, o->ancestorEmails->getElementDirect( i ) );
+        mtsWStr( f, o->ancestorRelNames->getElementDirect( i ) );
+        mtsWDbl( f, o->ancestorLifeStartTimeSeconds->getElementDirect( i ) );
+        }
+
+    mtsWInt( f, o->followingID );
+    mtsWInt( f, o->leadingColorIndex );
+    mtsWIntList( f, &( o->exiledByIDs ) );
+    mtsWInt( f, o->ownedPositions.size() );
+    for( int i=0; i<o->ownedPositions.size(); i++ ) {
+        GridPos p = o->ownedPositions.getElementDirect( i );
+        mtsWInt( f, p.x );
+        mtsWInt( f, p.y );
+        }
+
+    mtsWDbl( f, o->lifeStartTimeSeconds );
+    mtsWDbl( f, o->trueStartTimeSeconds );
+
+    // where they are right now
+    GridPos pos;
+    if( o->heldByOther ) {
+        LiveObject *holder = getLiveObject( o->heldByOtherID );
+        if( holder != NULL ) {
+            pos = getPlayerPos( holder );
+            }
+        else {
+            pos = getPlayerPos( o );
+            }
+        }
+    else if( o->vogMode ) {
+        pos = o->preVogPos;
+        }
+    else {
+        pos = getPlayerPos( o );
+        }
+    mtsWInt( f, pos.x );
+    mtsWInt( f, pos.y );
+    mtsWInt( f, o->facingLeft );
+    mtsWInt( f, o->originalBirthPos.x );
+    mtsWInt( f, o->originalBirthPos.y );
+    GridPos bp = o->vogMode ? o->preVogBirthPos : o->birthPos;
+    mtsWInt( f, bp.x );
+    mtsWInt( f, bp.y );
+
+    mtsWInt( f, o->heldByOther );
+    mtsWInt( f, o->heldByOtherID );
+    mtsWInt( f, o->everHeldByParent );
+
+    mtsWInt( f, o->foodStore );
+    mtsWDbl( f, o->foodCapModifier );
+    mtsWDbl( f, o->foodDecrementETASeconds );
+    mtsWIntList( f, &( o->yummyFoodChain ) );
+    mtsWInt( f, o->yummyBonusStore );
+    mtsWInt( f, o->lastAteID );
+    mtsWInt( f, o->lastAteFillMax );
+    mtsWInt( f, o->cravingFood.foodID );
+    mtsWInt( f, o->cravingFood.uniqueID );
+    mtsWInt( f, o->cravingFoodYumIncrement );
+    mtsWInt( f, o->personalEatBonus );
+    mtsWDbl( f, o->personalFoodDecrementSecondsBonus );
+    mtsWDbl( f, o->drunkenness );
+    mtsWDbl( f, o->fever );
+
+    mtsWDbl( f, o->bodyHeat );
+    mtsWDbl( f, o->heat );
+    mtsWDbl( f, o->envHeat );
+    mtsWDbl( f, o->biomeHeat );
+    mtsWDbl( f, o->lastBiomeHeat );
+
+    mtsWInt( f, o->holdingID );
+    mtsWDbl( f, o->holdingEtaDecay );
+    mtsWInt( f, o->numContained );
+    for( int c=0; c<o->numContained; c++ ) {
+        mtsWInt( f, o->containedIDs[c] );
+        mtsWDbl( f, o->containedEtaDecays[c] );
+        int numSub = 0;
+        if( o->subContainedIDs != NULL && o->subContainedEtaDecays != NULL ) {
+            numSub = o->subContainedIDs[c].size();
+            if( o->subContainedEtaDecays[c].size() < numSub ) {
+                numSub = o->subContainedEtaDecays[c].size();
+                }
+            }
+        mtsWInt( f, numSub );
+        for( int s=0; s<numSub; s++ ) {
+            mtsWInt( f, o->subContainedIDs[c].getElementDirect( s ) );
+            mtsWDbl( f, o->subContainedEtaDecays[c].getElementDirect( s ) );
+            }
+        }
+    mtsWInt( f, o->embeddedWeaponID );
+    mtsWDbl( f, o->embeddedWeaponEtaDecay );
+
+    for( int c=0; c<NUM_CLOTHING_PIECES; c++ ) {
+        mtsWInt( f, mtsObjID( clothingByIndex( o->clothing, c ) ) );
+        mtsWDbl( f, o->clothingEtaDecay[c] );
+        int n = o->clothingContained[c].size();
+        if( o->clothingContainedEtaDecays[c].size() < n ) {
+            n = o->clothingContainedEtaDecays[c].size();
+            }
+        mtsWInt( f, n );
+        for( int i=0; i<n; i++ ) {
+            mtsWInt( f, o->clothingContained[c].getElementDirect( i ) );
+            mtsWDbl( f,
+                     o->clothingContainedEtaDecays[c].getElementDirect( i ) );
+            }
+        }
+
+    mtsWInt( f, o->dying );
+    mtsWDbl( f, o->dyingETA );
+    mtsWInt( f, o->holdingWound );
+    mtsWInt( f, o->holdingBiomeSickness );
+    mtsWInt( f, o->murderSourceID );
+    mtsWInt( f, o->murderPerpID );
+    mtsWStr( f, o->murderPerpEmail );
+    mtsWInt( f, o->deathSourceID );
+
+    int numBabies = o->babyIDs->size();
+    if( o->babyBirthTimes->size() < numBabies ) {
+        numBabies = o->babyBirthTimes->size();
+        }
+    mtsWInt( f, numBabies );
+    for( int i=0; i<numBabies; i++ ) {
+        mtsWInt( f, o->babyIDs->getElementDirect( i ) );
+        mtsWDbl( f, o->babyBirthTimes->getElementDirect( i ) );
+        }
+    mtsWDbl( f, o->birthCoolDown );
+    mtsWStr( f, o->lastBabyEmail );
+    mtsWInt( f, o->sidsBabyEmails.size() );
+    for( int i=0; i<o->sidsBabyEmails.size(); i++ ) {
+        mtsWStr( f, o->sidsBabyEmails.getElementDirect( i ) );
+        }
+    mtsWInt( f, o->everHomesick );
+
+    mtsWInt( f, o->curseStatus.curseLevel );
+    mtsWInt( f, o->curseStatus.excessPoints );
+    mtsWInt( f, o->lifeStats.lifeCount );
+    mtsWInt( f, o->lifeStats.lifeTotalSeconds );
+    mtsWInt( f, o->lifeStats.accountExistedDays );
+    mtsWInt( f, o->lifeStats.error );
+    mtsWDbl( f, o->fitnessScore );
+    mtsWInt( f, o->curseTokenCount );
+    mtsWInt( f, o->numToolSlots );
+    mtsWIntList( f, &( o->learnedTools ) );
+    mtsWIntList( f, &( o->partiallyLearnedTools ) );
+    mtsWIntList( f, &( o->permanentEmots ) );
+    mtsWInt( f, o->everKilledAnyone );
+
+    fputs( " E\n", f );
+    }
