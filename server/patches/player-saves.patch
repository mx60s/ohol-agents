+static void mtsWStr( FILE *f, const char *s ) {
+    if( s == NULL || s[0] == '\0' ) {
+        fputs( " -", f );
+        return;
+        }
+    fputc( ' ', f );
+    for( const unsigned char *c = (const unsigned char*)s; *c != '\0'; c++ ) {
+        if( *c <= ' ' || *c >= 127 || *c == '%' ||
+            ( *c == '-' && c == (const unsigned char*)s && c[1] == '\0' ) ) {
+            fprintf( f, "%%%02X", *c );
+            }
+        else {
+            fputc( *c, f );
+            }
+        }
+    }
+
+static void mtsWInt( FILE *f, int v ) {
+    fprintf( f, " %d", v );
+    }
+
+static void mtsWDbl( FILE *f, double v ) {
+    fprintf( f, " %.17g", v );
+    }
+
+static void mtsWIntList( FILE *f, SimpleVector<int> *v ) {
+    mtsWInt( f, v->size() );
+    for( int i=0; i<v->size(); i++ ) {
+        mtsWInt( f, v->getElementDirect( i ) );
+        }
+    }
+
+static int mtsObjID( ObjectRecord *o ) {
+    if( o == NULL ) {
+        return 0;
+        }
+    return o->id;
+    }
