+// ---------------------------------------------------------------- restore
+
+static char mtsValidObject( int inID ) {
+    if( inID <= 0 ) {
+        return false;
+        }
+    return getObject( inID, true ) != NULL;
+    }
+
+// 0 if missing; game-clock ETA shifted (0 = never decays stays 0)
+static double mtsShiftEta( double inEta ) {
+    if( inEta == 0 ) {
+        return 0;
+        }
+    return inEta + mtsRestoreShift;
+    }
+
+static char *mtsDupOrNull( const std::string &s ) {
+    if( s.empty() ) {
+        return NULL;
+        }
+    return stringDuplicate( s.c_str() );
+    }
+
+
+// called from processLoggedInPlayer, after the fresh life is fully set up
+// and before it joins players
+static void mtsApplyRestore( LiveObject *o, MTSSavedPlayer *r ) {
+    double shift = mtsRestoreShift;
+
+    o->id = r->id;
+    o->displayID = r->displayID;
+
+    if( o->name != NULL ) {
+        delete [] o->name;
+        }
+    o->name = mtsDupOrNull( r->name );
+    if( o->familyName != NULL ) {
+        delete [] o->familyName;
+        }
+    o->familyName = mtsDupOrNull( r->familyName );
+    o->nameHasSuffix = r->nameHasSuffix;
+    o->forcedName = false;
+    o->isEve = r->isEve;
+    o->isRespawningEve = false;
+    o->isTwin = r->isTwin;
+
+    o->parentID = r->parentID;
+    o->parentChainLength = r->parentChainLength;
+    o->lineageEveID = r->lineageEveID;
+    o->lineage->deleteAll();
+    for( unsigned int k=0; k<r->lineage.size(); k++ ) {
+        o->lineage->push_back( r->lineage[k] );
+        }
+
+    o->ancestorIDs->deleteAll();
+    o->ancestorEmails->deallocateStringElements();
+    o->ancestorRelNames->deallocateStringElements();
+    o->ancestorLifeStartTimeSeconds->deleteAll();
+    for( unsigned int k=0; k<r->ancestors.size(); k++ ) {
+        MTSAncestor *a = &( r->ancestors[k] );
+        o->ancestorIDs->push_back( a->id );
+        o->ancestorEmails->push_back( stringDuplicate( a->email.c_str() ) );
+        o->ancestorRelNames->push_back(
+            stringDuplicate( a->relName.c_str() ) );
+        o->ancestorLifeStartTimeSeconds->push_back( a->lifeStart + shift );
+        }
+
+    o->followingID = r->followingID;
+    o->leadingColorIndex = r->leadingColorIndex;
+    o->followingUpdate = true;
+    o->exiledByIDs.deleteAll();
+    for( unsigned int k=0; k<r->exiledByIDs.size(); k++ ) {
+        o->exiledByIDs.push_back( r->exiledByIDs[k] );
+        }
+    o->exileUpdate = ( o->exiledByIDs.size() > 0 );
+    o->ownedPositions.deleteAll();
+    for( unsigned int k=0; k<r->ownedX.size(); k++ ) {
+        GridPos p = { r->ownedX[k], r->ownedY[k] };
+        o->ownedPositions.push_back( p );
+        }
+
+    o->lifeStartTimeSeconds = r->lifeStartTimeSeconds + shift;
+    o->trueStartTimeSeconds = r->trueStartTimeSeconds + shift;
+
+    o->xs = o->xd = r->x;
+    o->ys = o->yd = r->y;
+    o->facingLeft = r->facingLeft;
+    o->originalBirthPos.x = r->originalBirthX;
+    o->originalBirthPos.y = r->originalBirthY;
+    o->birthPos.x = r->birthX;
+    o->birthPos.y = r->birthY;
+    o->heldOriginValid = false;
+    o->heldOriginX = r->x;
+    o->heldOriginY = r->y;
+    o->actionTarget.x = r->x;
+    o->actionTarget.y = r->y;
+
+    // checked against the holder after everyone is restored
+    o->heldByOther = r->heldByOther;
+    o->heldByOtherID = r->heldByOtherID;
+    o->everHeldByParent = r->everHeldByParent;
+
+    o->foodStore = r->foodStore;
+    o->foodCapModifier = r->foodCapModifier;
+    o->foodDecrementETASeconds = r->foodDecrementETASeconds + shift;
+    o->yummyFoodChain.deleteAll();
+    for( unsigned int k=0; k<r->yummyFoodChain.size(); k++ ) {
+        o->yummyFoodChain.push_back( r->yummyFoodChain[k] );
+        }
+    o->yummyBonusStore = r->yummyBonusStore;
+    o->lastAteID = r->lastAteID;
+    o->lastAteFillMax = r->lastAteFillMax;
+    o->cravingFood.foodID = r->cravingFoodID;
+    o->cravingFood.uniqueID = r->cravingUniqueID;
+    o->cravingFoodYumIncrement = r->cravingFoodYumIncrement;
+    o->cravingKnown = false;
+    o->personalEatBonus = r->personalEatBonus;
+    o->personalFoodDecrementSecondsBonus =
+        r->personalFoodDecrementSecondsBonus;
+    o->drunkenness = r->drunkenness;
+    o->fever = r->fever;
+    o->foodUpdate = true;
+
+    o->bodyHeat = r->bodyHeat;
+    o->heat = r->heat;
+    o->envHeat = r->envHeat;
+    o->biomeHeat = r->biomeHeat;
+    o->lastBiomeHeat = r->lastBiomeHeat;
+
+    // hands (a negative holdingID is a baby, checked later)
+    freePlayerContainedArrays( o );
+    o->numContained = 0;
+    o->holdingID = 0;
+    o->holdingEtaDecay = 0;
+    if( r->holdingID < 0 || mtsValidObject( r->holdingID ) ) {
+        o->holdingID = r->holdingID;
+        o->holdingEtaDecay =
+            ( r->holdingID > 0 ) ? mtsShiftEta( r->holdingEtaDecay ) : 0;
+        }
+    if( o->holdingID > 0 && r->contained.size() > 0 ) {
+        int num = 0;
+        for( unsigned int k=0; k<r->contained.size(); k++ ) {
+            if( mtsValidObject( abs( r->contained[k].id ) ) ) {
+                num++;
+                }
+            }
+        if( num > 0 ) {
+            o->numContained = num;
+            o->containedIDs = new int[ num ];
+            o->containedEtaDecays = new timeSec_t[ num ];
+            o->subContainedIDs = new SimpleVector<int>[ num ];
+            o->subContainedEtaDecays = new SimpleVector<timeSec_t>[ num ];
+            int c = 0;
+            for( unsigned int k=0; k<r->contained.size(); k++ ) {
+                MTSContained *rc = &( r->contained[k] );
+                if( ! mtsValidObject( abs( rc->id ) ) ) {
+                    continue;
+                    }
+                int numSub = 0;
+                for( unsigned int s=0; s<rc->sub.size(); s++ ) {
+                    if( mtsValidObject( rc->sub[s].id ) ) {
+                        o->subContainedIDs[c].push_back( rc->sub[s].id );
+                        o->subContainedEtaDecays[c].push_back(
+                            mtsShiftEta( rc->sub[s].eta ) );
+                        numSub++;
+                        }
+                    }
+                // negative id marks "has sub-contained"
+                int id = abs( rc->id );
+                o->containedIDs[c] = ( numSub > 0 ) ? -id : id;
+                o->containedEtaDecays[c] = mtsShiftEta( rc->eta );
+                c++;
+                }
+            }
+        }
+    if( mtsValidObject( r->embeddedWeaponID ) ) {
+        o->embeddedWeaponID = r->embeddedWeaponID;
+        o->embeddedWeaponEtaDecay = mtsShiftEta( r->embeddedWeaponEtaDecay );
+        }
+
+    for( int c=0; c<NUM_CLOTHING_PIECES; c++ ) {
+        o->clothingContained[c].deleteAll();
+        o->clothingContainedEtaDecays[c].deleteAll();
+        if( mtsValidObject( r->clothingID[c] ) ) {
+            setClothingByIndex( &( o->clothing ), c,
+                                getObject( r->clothingID[c] ) );
+            o->clothingEtaDecay[c] = mtsShiftEta( r->clothingEta[c] );
+            for( unsigned int k=0; k<r->clothingContained[c].size(); k++ ) {
+                MTSTimedID *t = &( r->clothingContained[c][k] );
+                if( mtsValidObject( t->id ) ) {
+                    o->clothingContained[c].push_back( t->id );
+                    o->clothingContainedEtaDecays[c].push_back(
+                        mtsShiftEta( t->eta ) );
+                    }
+                }
+            }
+        else {
+            setClothingByIndex( &( o->clothing ), c, NULL );
+            o->clothingEtaDecay[c] = 0;
+            }
+        }
+
+    o->dying = r->dying;
+    o->dyingETA = r->dying ? r->dyingETA + shift : 0;
+    o->holdingWound = r->holdingWound;
+    o->holdingBiomeSickness = r->holdingBiomeSickness;
+    o->murderSourceID = r->murderSourceID;
+    o->murderPerpID = r->murderPerpID;
+    if( o->murderPerpEmail != NULL ) {
+        delete [] o->murderPerpEmail;
+        }
+    o->murderPerpEmail = mtsDupOrNull( r->murderPerpEmail );
+    o->deathSourceID = r->deathSourceID;
+
+    o->babyIDs->deleteAll();
+    o->babyBirthTimes->deleteAll();
+    for( unsigned int k=0; k<r->babies.size(); k++ ) {
+        o->babyIDs->push_back( r->babies[k].id );
+        o->babyBirthTimes->push_back( r->babies[k].eta + shift );
+        }
+    o->birthCoolDown = mtsShiftEta( r->birthCoolDown );
+    if( o->lastBabyEmail != NULL ) {
+        delete [] o->lastBabyEmail;
+        }
+    o->lastBabyEmail = mtsDupOrNull( r->lastBabyEmail );
+    o->sidsBabyEmails.deallocateStringElements();
+    for( unsigned int k=0; k<r->sidsBabyEmails.size(); k++ ) {
+        o->sidsBabyEmails.push_back(
+            stringDuplicate( r->sidsBabyEmails[k].c_str() ) );
+        }
+    o->everHomesick = r->everHomesick;
+
+    o->curseStatus.curseLevel = r->curseLevel;
+    o->curseStatus.excessPoints = r->excessPoints;
+    o->lifeStats.lifeCount = r->lifeCount;
+    o->lifeStats.lifeTotalSeconds = r->lifeTotalSeconds;
+    o->lifeStats.accountExistedDays = r->accountExistedDays;
+    o->lifeStats.error = r->lifeStatsError;
+    o->fitnessScore = r->fitnessScore;
+    o->curseTokenCount = r->curseTokenCount;
+    o->numToolSlots = r->numToolSlots;
+    o->learnedTools.deleteAll();
+    for( unsigned int k=0; k<r->learnedTools.size(); k++ ) {
+        o->learnedTools.push_back( r->learnedTools[k] );
+        }
+    o->partiallyLearnedTools.deleteAll();
+    for( unsigned int k=0; k<r->partiallyLearnedTools.size(); k++ ) {
+        o->partiallyLearnedTools.push_back( r->partiallyLearnedTools[k] );
+        }
+    o->permanentEmots.deleteAll();
+    for( unsigned int k=0; k<r->permanentEmots.size(); k++ ) {
+        o->permanentEmots.push_back( r->permanentEmots[k] );
+        }
+    o->everKilledAnyone = r->everKilledAnyone;
+
+    // waits for the stock reconnect path in processLoggedInPlayer
+    // (as if they had been connected before: the main loop must not send
+    // a first message to a NULL socket; reconnect resets these)
+    o->connected = false;
+    o->sock = NULL;
+    o->sockBuffer = NULL;
+    o->firstMessageSent = true;
+    o->firstMapSent = true;
+    o->inFlight = false;
+    }
