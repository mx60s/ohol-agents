+// ---------------------------------------------------------------- reading
+
+// whitespace tokenizer over a line; any failure sets ok = false and
+// every later read returns a harmless default
+struct MTSReader {
+        const char *p;
+        char ok;
+
+        const char *next( int *outLen ) {
+            while( *p == ' ' || *p == '\t' ) p++;
+            if( *p == '\0' || *p == '\n' || *p == '\r' ) {
+                ok = false;
+                *outLen = 0;
+                return "";
+                }
+            const char *start = p;
+            while( *p != '\0' && *p != ' ' && *p != '\t' && *p != '\n' &&
+                   *p != '\r' ) {
+                p++;
+                }
+            *outLen = p - start;
+            return start;
+            }
+
+        int i() {
+            int len;
+            const char *t = next( &len );
+            if( ! ok ) return 0;
+            char buf[32];
+            if( len >= 31 ) { ok = false; return 0; }
+            memcpy( buf, t, len );
+            buf[len] = '\0';
+            char *end;
+            errno = 0;
+            long v = strtol( buf, &end, 10 );
+            if( *end != '\0' || errno != 0 ||
+                v > 2147483647L || v < -2147483647L ) {
+                ok = false;
+                return 0;
+                }
+            return (int)v;
+            }
+
+        // list length, bounded
+        int n( int inMax = 10000 ) {
+            int v = i();
+            if( v < 0 || v > inMax ) {
+                ok = false;
+                return 0;
+                }
+            return v;
+            }
+
+        double d() {
+            int len;
+            const char *t = next( &len );
+            if( ! ok ) return 0;
+            char buf[64];
+            if( len >= 63 ) { ok = false; return 0; }
+            memcpy( buf, t, len );
+            buf[len] = '\0';
+            char *end;
+            double v = strtod( buf, &end );
+            if( *end != '\0' || v != v ) {
+                ok = false;
+                return 0;
+                }
+            return v;
+            }
+
+        std::string s() {
+            int len;
+            const char *t = next( &len );
+            if( ! ok ) return "";
+            if( len == 1 && t[0] == '-' ) {
+                return "";
+                }
+            std::string out;
+            for( int k=0; k<len; k++ ) {
+                if( t[k] == '%' ) {
+                    if( k + 2 >= len ) {
+                        ok = false;
+                        return "";
+                        }
+                    char hex[3] = { t[k+1], t[k+2], '\0' };
+                    char *end;
+                    long v = strtol( hex, &end, 16 );
+                    if( *end != '\0' || v <= 0 ) {
+                        ok = false;
+                        return "";
+                        }
+                    out.push_back( (char)v );
+                    k += 2;
+                    }
+                else {
+                    out.push_back( t[k] );
+                    }
+                }
+            return out;
+            }
+
+        void intList( std::vector<int> *outV, int inMax = 10000 ) {
+            int num = n( inMax );
+            for( int k=0; k<num && ok; k++ ) {
+                outV->push_back( i() );
+                }
+            }
+
+        void timedList( std::vector<MTSTimedID> *outV ) {
+            int num = n();
+            for( int k=0; k<num && ok; k++ ) {
+                MTSTimedID t;
+                t.id = i();
+                t.eta = d();
+                outV->push_back( t );
+                }
+            }
+    };
+
+
+static char mtsReadPlayer( const char *inLine, MTSSavedPlayer *r ) {
+    MTSReader R = { inLine, true };
+
+    int len;
+    const char *tag = R.next( &len );
+    if( ! R.ok || len != 1 || tag[0] != 'P' ) {
+        return false;
+        }
+
+    r->email = R.s();
+    r->id = R.i();
+    r->displayID = R.i();
+    r->name = R.s();
+    r->familyName = R.s();
+    r->nameHasSuffix = R.i();
+    r->isEve = R.i();
+    r->isTwin = R.i();
+
+    r->parentID = R.i();
+    r->parentChainLength = R.i();
+    r->lineageEveID = R.i();
+    R.intList( &( r->lineage ) );
+
+    int numAnc = R.n();
+    for( int k=0; k<numAnc && R.ok; k++ ) {
+        MTSAncestor a;
+        a.id = R.i();
+        a.email = R.s();
+        a.relName = R.s();
+        a.lifeStart = R.d();
+        r->ancestors.push_back( a );
+        }
+
+    r->followingID = R.i();
+    r->leadingColorIndex = R.i();
+    R.intList( &( r->exiledByIDs ) );
+    int numOwned = R.n( 100000 );
+    for( int k=0; k<numOwned && R.ok; k++ ) {
+        r->ownedX.push_back( R.i() );
+        r->ownedY.push_back( R.i() );
+        }
+
+    r->lifeStartTimeSeconds = R.d();
+    r->trueStartTimeSeconds = R.d();
+
+    r->x = R.i();
+    r->y = R.i();
+    r->facingLeft = R.i();
+    r->originalBirthX = R.i();
+    r->originalBirthY = R.i();
+    r->birthX = R.i();
+    r->birthY = R.i();
+
+    r->heldByOther = R.i();
+    r->heldByOtherID = R.i();
+    r->everHeldByParent = R.i();
+
+    r->foodStore = R.i();
+    r->foodCapModifier = R.d();
+    r->foodDecrementETASeconds = R.d();
+    R.intList( &( r->yummyFoodChain ), 100000 );
+    r->yummyBonusStore = R.i();
+    r->lastAteID = R.i();
+    r->lastAteFillMax = R.i();
+    r->cravingFoodID = R.i();
+    r->cravingUniqueID = R.i();
+    r->cravingFoodYumIncrement = R.i();
+    r->personalEatBonus = R.i();
+    r->personalFoodDecrementSecondsBonus = R.d();
+    r->drunkenness = R.d();
+    r->fever = R.d();
+
+    r->bodyHeat = R.d();
+    r->heat = R.d();
+    r->envHeat = R.d();
+    r->biomeHeat = R.d();
+    r->lastBiomeHeat = R.d();
+
+    r->holdingID = R.i();
+    r->holdingEtaDecay = R.d();
+    int numCont = R.n( 1000 );
+    for( int k=0; k<numCont && R.ok; k++ ) {
+        MTSContained c;
+        c.id = R.i();
+        c.eta = R.d();
+        int numSub = R.n( 1000 );
+        for( int s=0; s<numSub && R.ok; s++ ) {
+            MTSTimedID t;
+            t.id = R.i();
+            t.eta = R.d();
+            c.sub.push_back( t );
+            }
+        r->contained.push_back( c );
+        }
+    r->embeddedWeaponID = R.i();
+    r->embeddedWeaponEtaDecay = R.d();
+
+    for( int c=0; c<NUM_CLOTHING_PIECES; c++ ) {
+        r->clothingID[c] = R.i();
+        r->clothingEta[c] = R.d();
+        R.timedList( &( r->clothingContained[c] ) );
+        }
+
+    r->dying = R.i();
+    r->dyingETA = R.d();
+    r->holdingWound = R.i();
+    r->holdingBiomeSickness = R.i();
+    r->murderSourceID = R.i();
+    r->murderPerpID = R.i();
+    r->murderPerpEmail = R.s();
+    r->deathSourceID = R.i();
+
+    R.timedList( &( r->babies ) );
+    r->birthCoolDown = R.d();
+    r->lastBabyEmail = R.s();
+    int numSids = R.n();
+    for( int k=0; k<numSids && R.ok; k++ ) {
+        r->sidsBabyEmails.push_back( R.s() );
+        }
+    r->everHomesick = R.i();
+
+    r->curseLevel = R.i();
+    r->excessPoints = R.i();
+    r->lifeCount = R.i();
+    r->lifeTotalSeconds = R.i();
+    r->accountExistedDays = R.i();
+    r->lifeStatsError = R.i();
+    r->fitnessScore = R.d();
+    r->curseTokenCount = R.i();
+    r->numToolSlots = R.i();
+    R.intList( &( r->learnedTools ) );
+    R.intList( &( r->partiallyLearnedTools ) );
+    R.intList( &( r->permanentEmots ) );
+    r->everKilledAnyone = R.i();
+
+    const char *endTag = R.next( &len );
+    if( ! R.ok || len != 1 || endTag[0] != 'E' ) {
+        return false;
+        }
+
+    if( r->email.empty() || r->id <= 0 ) {
+        return false;
+        }
+    return true;
+    }
