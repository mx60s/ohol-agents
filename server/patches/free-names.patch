+// MTS patch: with setting mtsFreeNames=1, names are taken as spoken
+// (letters only, max 2 words of 16 chars) instead of being snapped to the
+// closest entry in firstNames/lastNames.txt.
+//
+// Naming rules (agents/src/agent/naming.ts does the same before speaking):
+// - no two families share a surname, ever: an Eve naming whose family name
+//   a living family has, or any family named on this server had
+//   (mtsFamilyNames.txt in the run dir), is refused and the namer is told;
+// - a repeated first name in a family is numbered: a baby's first name may
+//   carry a Roman numeral II..X as a second word (AURORA II -> AURORA II
+//   DAWN, family DAWN), and a name already in use is numbered by the server.
+
+// II..X, the numerals a repeated first name can carry
+static char mtsIsNumeral( const char *inWord ) {
+    const char *numerals[9] =
+        { "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" };
+    for( int i=0; i<9; i++ ) {
+        if( strcmp( inWord, numerals[i] ) == 0 ) {
+            return true;
+            }
+        }
+    return false;
+    }
+
+static const char *mtsRoman( int inN ) {
+    const char *numerals[11] =
+        { "", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" };
+    if( inN < 0 || inN > 10 ) {
+        return "";
+        }
+    return numerals[ inN ];
+    }
+
+// any words
+#define MTS_NAME_ANY 0
+// numerals skipped (an Eve has no namesakes to count)
+#define MTS_NAME_EVE 1
+// the first word, plus a numeral II..X if one follows it
+#define MTS_NAME_BABY 2
+
+// Returns a static buffer (max 2 words of 16 letters).
+static const char *mtsCleanName( const char *inName, int inMaxWords,
+                                 int inMode = MTS_NAME_ANY ) {
+    static char buf[40];
+    char words[8][17];
+    int numWords = 0, inWord = 0, wordLen = 0;
+    for( const char *c = inName; *c != '\0'; c++ ) {
+        char ch = *c;
+        if( ch >= 'a' && ch <= 'z' ) ch = ch - 'a' + 'A';
+        if( ch >= 'A' && ch <= 'Z' ) {
+            if( ! inWord ) {
+                if( numWords == 8 ) break;
+                numWords++;
+                inWord = 1;
+                wordLen = 0;
+                }
+            if( wordLen < 16 ) {
+                words[ numWords - 1 ][ wordLen++ ] = ch;
+                words[ numWords - 1 ][ wordLen ] = '\0';
+                }
+            }
+        else {
+            inWord = 0;
+            }
+        }
+    int n = 0, kept = 0;
+    buf[0] = '\0';
+    for( int i=0; i<numWords && kept < inMaxWords && kept < 2; i++ ) {
+        if( inMode == MTS_NAME_EVE && mtsIsNumeral( words[i] ) ) {
+            continue;
+            }
+        if( inMode == MTS_NAME_BABY && kept == 1 &&
+            ! mtsIsNumeral( words[i] ) ) {
+            break;
+            }
+        if( kept > 0 ) buf[n++] = ' ';
+        int len = strlen( words[i] );
+        memcpy( &( buf[n] ), words[i], len );
+        n += len;
+        buf[n] = '\0';
+        kept++;
+        }
+    if( n == 0 ) {
+        return "NAMELESS";
+        }
+    return buf;
+    }
+
