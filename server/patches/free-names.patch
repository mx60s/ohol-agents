+static SimpleVector<char*> mtsFamilyNames;
+static char mtsFamilyNamesLoaded = false;
+static const char *mtsFamilyNamesFile = "mtsFamilyNames.txt";
+
+static void mtsLoadFamilyNames() {
+    if( mtsFamilyNamesLoaded ) {
+        return;
+        }
+    mtsFamilyNamesLoaded = true;
+    FILE *f = fopen( mtsFamilyNamesFile, "r" );
+    if( f == NULL ) {
+        return;
+        }
+    char word[64];
+    while( fscanf( f, "%63s", word ) == 1 ) {
+        mtsFamilyNames.push_back( stringDuplicate( word ) );
+        }
+    fclose( f );
+    }
+
+// a family on this server has (or had) this surname
+static char mtsFamilyNameUsed( const char *inFamily ) {
+    mtsLoadFamilyNames();
+    for( int i=0; i<mtsFamilyNames.size(); i++ ) {
+        if( strcmp( mtsFamilyNames.getElementDirect( i ), inFamily ) == 0 ) {
+            return true;
+            }
+        }
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( ! o->error && o->familyName != NULL &&
+            strcmp( o->familyName, inFamily ) == 0 ) {
+            return true;
+            }
+        }
+    return false;
+    }
+
+static void mtsRecordFamilyName( const char *inFamily ) {
+    mtsLoadFamilyNames();
+    for( int i=0; i<mtsFamilyNames.size(); i++ ) {
+        if( strcmp( mtsFamilyNames.getElementDirect( i ), inFamily ) == 0 ) {
+            return;
+            }
+        }
+    mtsFamilyNames.push_back( stringDuplicate( inFamily ) );
+    FILE *f = fopen( mtsFamilyNamesFile, "a" );
+    if( f != NULL ) {
+        fprintf( f, "%s\n", inFamily );
+        fclose( f );
+        }
+    }
+
+
+// With mtsFreeNames=1: each lineage's family name, by lineage (Eve) id, so
+// the surname outlives every named member (stock looks only at living
+// members with a family name). mtsLineageFamilies.txt in the run dir, lines
+// "<lineageEveID> <FAMILY>" ("-" = forgotten), last line wins; a world reset
+// deletes it with the other world files.
+static SimpleVector<int> mtsLineageIDs;
+static SimpleVector<char*> mtsLineageFams;
+static char mtsLineageLoaded = false;
+static const char *mtsLineageFile = "mtsLineageFamilies.txt";
+
+static void mtsLineageSet( int inID, const char *inFamily, char inWrite ) {
+    char *fam = ( inFamily == NULL ) ? NULL : stringDuplicate( inFamily );
+    char found = false;
+    for( int i=0; i<mtsLineageIDs.size(); i++ ) {
+        if( mtsLineageIDs.getElementDirect( i ) == inID ) {
+            char *old = mtsLineageFams.getElementDirect( i );
+            if( old != NULL ) {
+                delete [] old;
+                }
+            *( mtsLineageFams.getElement( i ) ) = fam;
+            found = true;
+            break;
+            }
+        }
+    if( ! found ) {
+        if( fam == NULL ) {
+            return;
+            }
+        mtsLineageIDs.push_back( inID );
+        mtsLineageFams.push_back( fam );
+        }
+    if( inWrite ) {
+        FILE *f = fopen( mtsLineageFile, "a" );
+        if( f != NULL ) {
+            fprintf( f, "%d %s\n", inID, inFamily == NULL ? "-" : inFamily );
+            fclose( f );
+            }
+        }
+    }
+
+static void mtsLoadLineageFamilies() {
+    if( mtsLineageLoaded ) {
+        return;
+        }
+    mtsLineageLoaded = true;
+    FILE *f = fopen( mtsLineageFile, "r" );
+    if( f == NULL ) {
+        return;
+        }
+    int id;
+    char word[64];
+    while( fscanf( f, "%d %63s", &id, word ) == 2 ) {
+        mtsLineageSet( id, strcmp( word, "-" ) == 0 ? NULL : word, false );
+        }
+    fclose( f );
+    }
+
+// NULL if none recorded (or mtsFreeNames=0)
+static const char *mtsLineageFamily( int inLineageEveID ) {
+    if( ! SettingsManager::getIntSetting( "mtsFreeNames", 0 ) ) {
+        return NULL;
+        }
+    mtsLoadLineageFamilies();
+    for( int i=0; i<mtsLineageIDs.size(); i++ ) {
+        if( mtsLineageIDs.getElementDirect( i ) == inLineageEveID ) {
+            return mtsLineageFams.getElementDirect( i );
+            }
+        }
+    return NULL;
+    }
+
+static void mtsForgetLineageFamily( int inLineageEveID ) {
+    if( mtsLineageFamily( inLineageEveID ) != NULL ) {
+        mtsLineageSet( inLineageEveID, NULL, true );
+        }
+    }
+
+// an Eve named her family: record it, and give it to her living
+// descendants born before the naming (their familyName is still NULL)
+static void mtsLineageNamed( LiveObject *inEve ) {
+    if( ! SettingsManager::getIntSetting( "mtsFreeNames", 0 ) ||
+        inEve->familyName == NULL ) {
+        return;
+        }
+    mtsLoadLineageFamilies();
+    const char *old = mtsLineageFamily( inEve->lineageEveID );
+    if( old == NULL || strcmp( old, inEve->familyName ) != 0 ) {
+        mtsLineageSet( inEve->lineageEveID, inEve->familyName, true );
+        }
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( o != inEve && ! o->error &&
+            o->lineageEveID == inEve->lineageEveID &&
+            o->familyName == NULL ) {
+            o->familyName = stringDuplicate( inEve->familyName );
+            }
+        }
+    }
+
+// With mtsFreeNames=1: true if naming an Eve with these words must be
+// refused because her family name is taken; tells inNamer why.
+static char mtsEveNamingRefused( LiveObject *inNamer, const char *inName ) {
+    if( ! SettingsManager::getIntSetting( "mtsFreeNames", 0 ) ) {
+        return false;
+        }
+    // same words as nameEve: "MARIA HOPE" -> HOPE, "HOPE" -> HOPE
+    const char *clean = mtsCleanName( inName, 2, MTS_NAME_EVE );
+    const char *space = strstr( clean, " " );
+    char *family = stringDuplicate( space != NULL ? &( space[1] ) : clean );
+    char refused = mtsFamilyNameUsed( family );
+    if( refused ) {
+        char *message = autoSprintf(
+            "THE FAMILY NAME %s IS ALREADY TAKEN.**CHOOSE A NEW ONE.",
+            family );
+        sendGlobalMessage( message, inNamer );
+        delete [] message;
+        }
+    delete [] family;
+    return refused;
+    }
