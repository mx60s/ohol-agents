+// MTS patch: with setting mtsFreeNames=1, names are taken as spoken
+// (letters only, max 2 words of 16 chars) instead of being snapped to the
+// closest entry in firstNames/lastNames.txt. Returns a static buffer.
+static const char *mtsCleanName( const char *inName, int inMaxWords ) {
+    static char buf[40];
+    int n = 0, words = 0, inWord = 0, wordLen = 0;
+    for( const char *c = inName; *c != '\0' && n < 38; c++ ) {
+        char ch = *c;
+        if( ch >= 'a' && ch <= 'z' ) ch = ch - 'a' + 'A';
+        if( ch >= 'A' && ch <= 'Z' ) {
+            if( ! inWord ) {
+                if( words == inMaxWords ) break;
+                if( words > 0 ) buf[n++] = ' ';
+                words++;
+                inWord = 1;
+                wordLen = 0;
+                }
+            if( wordLen < 16 ) {
+                buf[n++] = ch;
+                wordLen++;
+                }
+            }
+        else {
+            inWord = 0;
+            }
+        }
+    buf[n] = '\0';
+    if( n == 0 ) {
+        return "NAMELESS";
+        }
+    return buf;
+    }
+
