+static SimpleVector<char*> mtsFamilyNames;
+static char mtsFamilyNamesLoaded = false;
+static const char *mtsFamilyNamesFile = "mtsFamilyNames.txt";
+
+static void mtsLoadFamilyNames() {
+    if( mtsFamilyNamesLoaded ) {
+        return;
+        }
+    mtsFamilyNamesLoaded = true;
+    FILE *f = fopen( mtsFamilyNamesFile, "r" );
+    if( f == NULL ) {
+        return;
+        }
+    char word[64];
+    while( fscanf( f, "%63s", word ) == 1 ) {
+        mtsFamilyNames.push_back( stringDuplicate( word ) );
+        }
+    fclose( f );
+    }
+
+// a family on this server has (or had) this surname
+static char mtsFamilyNameUsed( const char *inFamily ) {
+    mtsLoadFamilyNames();
+    for( int i=0; i<mtsFamilyNames.size(); i++ ) {
+        if( strcmp( mtsFamilyNames.getElementDirect( i ), inFamily ) == 0 ) {
+            return true;
+            }
+        }
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( ! o->error && o->familyName != NULL &&
+            strcmp( o->familyName, inFamily ) == 0 ) {
+            return true;
+            }
+        }
+    return false;
+    }
+
+static void mtsRecordFamilyName( const char *inFamily ) {
+    mtsLoadFamilyNames();
+    for( int i=0; i<mtsFamilyNames.size(); i++ ) {
+        if( strcmp( mtsFamilyNames.getElementDirect( i ), inFamily ) == 0 ) {
+            return;
+            }
+        }
+    mtsFamilyNames.push_back( stringDuplicate( inFamily ) );
+    FILE *f = fopen( mtsFamilyNamesFile, "a" );
+    if( f != NULL ) {
+        fprintf( f, "%s\n", inFamily );
+        fclose( f );
+        }
+    }
 
+// With mtsFreeNames=1: true if naming an Eve with these words must be
+// refused because her family name is taken; tells inNamer why.
+static char mtsEveNamingRefused( LiveObject *inNamer, const char *inName ) {
+    if( ! SettingsManager::getIntSetting( "mtsFreeNames", 0 ) ) {
+        return false;
+        }
+    // same words as nameEve: "MARIA HOPE" -> HOPE, "HOPE" -> HOPE
+    const char *clean = mtsCleanName( inName, 2, MTS_NAME_EVE );
+    const char *space = strstr( clean, " " );
+    char *family = stringDuplicate( space != NULL ? &( space[1] ) : clean );
+    char refused = mtsFamilyNameUsed( family );
+    if( refused ) {
+        char *message = autoSprintf(
+            "THE FAMILY NAME %s IS ALREADY TAKEN.**CHOOSE A NEW ONE.",
+            family );
+        sendGlobalMessage( message, inNamer );
+        delete [] message;
+        }
+    delete [] family;
+    return refused;
+    }
 
 
