+// MTS patch (language-learning.patch): learning by living together.
+
+static LanguageLearningMap *mtsLearningMapFor( int inEveIDA, int inEveIDB,
+                                               int inPlayerID,
+                                               char inCreate ) {
+    int lookupEveID = inEveIDA;
+    int otherEveID = inEveIDB;
+    if( inEveIDB > lookupEveID ) {
+        lookupEveID = inEveIDB;
+        otherEveID = inEveIDA;
+        }
+    // age 0: may create the map at any age (stock only below
+    // maxLanguageLearningAge); a too-old age never creates one
+    return getPlayerLearningMap( lookupEveID, otherEveID, inPlayerID,
+                                 inCreate ? 0 : maxLanguageLearningAge + 1 );
+    }
+
+
+void mtsLearnLanguage( int inEveIDA, int inEveIDB, int inPlayerID,
+                       double inFraction ) {
+    if( inEveIDA == inEveIDB || inFraction <= 0 ) {
+        return;
+        }
+    LanguageLearningMap *map =
+        mtsLearningMapFor( inEveIDA, inEveIDB, inPlayerID, true );
+    if( map != NULL ) {
+        learnWeightFraction( map, inFraction );
+        }
+    }
+
+
+double mtsLanguageKnownFraction( int inEveIDA, int inEveIDB,
+                                 int inPlayerID ) {
+    if( inEveIDA == inEveIDB ) {
+        return 1;
+        }
+    LanguageLearningMap *map =
+        mtsLearningMapFor( inEveIDA, inEveIDB, inPlayerID, false );
+    if( map == NULL ) {
+        return 0;
+        }
+    double known = 0, total = 0;
+    for( int s=0; s<NUM_CLUSTER_SETS; s++ ) {
+        for( int c=0; c<allClusterSizes[s]; c++ ) {
+            total += allClustersFreq[s][c];
+            if( map->allMappings[s][c] ) {
+                known += allClustersFreq[s][c];
+                }
+            }
+        }
+    return total > 0 ? known / total : 0;
+    }
+
+
+// one line per learning map:
+// "M <playerID> <eveIDA> <eveIDB> <firstPhraseHeard> <set0> .. <set4>",
+// each set a string of 0/1 per cluster
+char mtsSaveLanguageLearning( const char *inFileName ) {
+    char *tmpName = autoSprintf( "%s.tmp", inFileName );
+    FILE *f = fopen( tmpName, "w" );
+    if( f == NULL ) {
+        delete [] tmpName;
+        return false;
+        }
+    for( int p=0; p<learningRecords.size(); p++ ) {
+        PlayerLearningRecord *r = learningRecords.getElementDirect( p );
+        for( int m=0; m<r->learningMaps.size(); m++ ) {
+            LanguageLearningMap *map = r->learningMaps.getElementDirect( m );
+            fprintf( f, "M %d %d %d %d", r->playerID, map->eveIDA,
+                     map->eveIDB, map->firstPhraseHeard ? 1 : 0 );
+            for( int s=0; s<NUM_CLUSTER_SETS; s++ ) {
+                fputc( ' ', f );
+                for( int c=0; c<allClusterSizes[s]; c++ ) {
+                    fputc( map->allMappings[s][c] ? '1' : '0', f );
+                    }
+                }
+            fputc( '\n', f );
+            }
+        }
+    char ok = ( fclose( f ) == 0 );
+    if( ok ) {
+        ok = ( rename( tmpName, inFileName ) == 0 );
+        }
+    delete [] tmpName;
+    return ok;
+    }
+
+
+// only maps of players in inLivePlayerIDs (ids restart with a new world);
+// returns the number of maps loaded
+int mtsLoadLanguageLearning( const char *inFileName,
+                             SimpleVector<int> *inLivePlayerIDs ) {
+    FILE *f = fopen( inFileName, "r" );
+    if( f == NULL ) {
+        return 0;
+        }
+    int maxLen = NUM_MIDDLE_CONSONANT_CLUSTERS;
+    for( int s=0; s<NUM_CLUSTER_SETS; s++ ) {
+        if( allClusterSizes[s] > maxLen ) {
+            maxLen = allClusterSizes[s];
+            }
+        }
+    char *bits = new char[ maxLen + 2 ];
+    char *fmt = autoSprintf( "%%%ds", maxLen + 1 );
+    int count = 0;
+    int playerID, eveA, eveB, heard;
+    while( fscanf( f, " M %d %d %d %d", &playerID, &eveA, &eveB,
+                   &heard ) == 4 ) {
+        char keep = inLivePlayerIDs->getElementIndex( playerID ) != -1;
+        LanguageLearningMap *map = keep ?
+            mtsLearningMapFor( eveA, eveB, playerID, true ) : NULL;
+        char ok = true;
+        for( int s=0; s<NUM_CLUSTER_SETS; s++ ) {
+            if( fscanf( f, fmt, bits ) != 1 ||
+                (int)strlen( bits ) != allClusterSizes[s] ) {
+                ok = false;
+                break;
+                }
+            if( map != NULL ) {
+                for( int c=0; c<allClusterSizes[s]; c++ ) {
+                    if( bits[c] == '1' ) {
+                        map->allMappings[s][c] = true;
+                        }
+                    }
+                }
+            }
+        if( ! ok ) {
+            break;
+            }
+        if( map != NULL ) {
+            if( heard ) {
+                map->firstPhraseHeard = true;
+                }
+            count++;
+            }
+        }
+    delete [] fmt;
+    delete [] bits;
+    fclose( f );
+    return count;
+    }
