diff --git a/server/server.cpp b/server/server.cpp
index da95ae8..9437c13 100644
--- a/server/server.cpp
+++ b/server/server.cpp
@@ -14350,6 +14350,140 @@ SimpleVector<KillState> activeKillStates;
 
 
 
+// MTS patch (language-learning.patch): adults learn each other's family
+// language by living together in peace. Every mtsLangTickSeconds game
+// seconds (default 6), each pair of living players of different lineages
+// within mtsLangRadius tiles (default 16, the speech radius) both learn a
+// fraction of what they don't know yet of the language between their two
+// lineages, at any age, with the stock first-hearing step
+// (language.cpp learnWeightFraction), so the scrambling shrinks cluster by
+// cluster. The step always learns at least one whole cluster per cluster
+// set, frequency-weighted, so the pace is set mostly by how often it runs:
+// about 50 steps of 1.2% leave 5% of the weight unlearned (simulated with
+// the stock cluster tables: 12% after one step, 70% after 10, 84% after
+// 20, 90% after 30, 95% after 50). So each tick a pair learns with
+// probability min( 1, r ) and fraction 1.2% * max( 1, r )^2, where
+// r = 50 * tick / mtsLangFullSeconds (setting; 0 or absent = off, stock):
+// mtsLangFullSeconds game seconds of being together leave about 5%. Not while either is in a kill state (a weapon raised,
+// or the target of one), either has exiled the other, or their lineages
+// are at war. The maps are kept in mtsLanguageLearning.txt (run dir) after
+// each tick and loaded at the first tick (players restored by player saves
+// keep what they learned; a world reset deletes the file).
+
+static const char *mtsLangFile = "mtsLanguageLearning.txt";
+
+static char mtsInKillState( LiveObject *inP ) {
+    for( int i=0; i<activeKillStates.size(); i++ ) {
+        KillState *k = activeKillStates.getElement( i );
+        if( k->killerID == inP->id || k->targetID == inP->id ) {
+            return true;
+            }
+        }
+    return false;
+    }
+
+
+static void mtsStepLanguageLearning() {
+    static double lastTick = -1;
+    static char loaded = false;
+
+    double fullSeconds =
+        SettingsManager::getFloatSetting( "mtsLangFullSeconds", 0.0f );
+    if( ! ( fullSeconds > 0 ) ) {
+        return;
+        }
+    double tick = SettingsManager::getFloatSetting( "mtsLangTickSeconds", 6.0f );
+    if( ! ( tick > 0 ) ) {
+        tick = 6;
+        }
+    double now = Time::getCurrentTime();
+
+    if( ! loaded ) {
+        loaded = true;
+        lastTick = now;
+        SimpleVector<int> liveIDs;
+        for( int i=0; i<players.size(); i++ ) {
+            LiveObject *o = players.getElement( i );
+            if( ! o->error ) {
+                liveIDs.push_back( o->id );
+                }
+            }
+        int n = mtsLoadLanguageLearning( mtsLangFile, &liveIDs );
+        AppLog::infoF( "MTS language learning: loaded %d maps from %s "
+                       "(full in %.0f game s, tick %.1f s)",
+                       n, mtsLangFile, fullSeconds, tick );
+        return;
+        }
+    if( now - lastTick < tick ) {
+        return;
+        }
+    // ticks due since the last pass (the main loop can sleep longer than a
+    // tick when the game clock runs fast), at most 10
+    int steps = (int)( ( now - lastTick ) / tick );
+    if( steps > 10 ) {
+        steps = 10;
+        lastTick = now;
+        }
+    else {
+        lastTick += steps * tick;
+        }
+
+    double radius = SettingsManager::getFloatSetting( "mtsLangRadius", 16.0f );
+    // see the top: ~50 learning steps of 1.2% in fullSeconds
+    double r = 50 * tick / fullSeconds;
+    double chance = r < 1 ? r : 1;
+    double fraction = 0.012 * ( r > 1 ? r * r : 1 );
+    if( fraction > 0.5 ) {
+        fraction = 0.5;
+        }
+
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *a = players.getElement( i );
+        if( a->error || a->isTutorial || a->isGhost ) {
+            continue;
+            }
+        for( int j=i+1; j<players.size(); j++ ) {
+            LiveObject *b = players.getElement( j );
+            if( b->error || b->isTutorial || b->isGhost ||
+                a->lineageEveID == b->lineageEveID ) {
+                continue;
+                }
+            if( distance( getPlayerPos( a ), getPlayerPos( b ) ) > radius ) {
+                continue;
+                }
+            if( mtsInKillState( a ) || mtsInKillState( b ) ||
+                isExiled( a, b ) || isExiled( b, a ) ||
+                isWarState( a->lineageEveID, b->lineageEveID ) ) {
+                continue;
+                }
+            for( int k=0; k<steps; k++ ) {
+                if( chance < 1 && randSource.getRandomDouble() > chance ) {
+                    continue;
+                    }
+                mtsLearnLanguage( a->lineageEveID, b->lineageEveID, a->id,
+                                  fraction );
+                mtsLearnLanguage( a->lineageEveID, b->lineageEveID, b->id,
+                                  fraction );
+                }
+            if( SettingsManager::getIntSetting( "mtsLangLog", 0 ) ) {
+                AppLog::infoF(
+                    "MTS language learning: %d knows %.3f, %d knows %.3f",
+                    a->id, mtsLanguageKnownFraction( a->lineageEveID,
+                                                     b->lineageEveID, a->id ),
+                    b->id, mtsLanguageKnownFraction( a->lineageEveID,
+                                                     b->lineageEveID, b->id ) );
+                }
+            }
+        }
+
+    if( ! mtsSaveLanguageLearning( mtsLangFile ) ) {
+        AppLog::errorF( "MTS language learning: can't write %s",
+                        mtsLangFile );
+        }
+    }
+
+
